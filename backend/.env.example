APP_ENV=development
DATABASE_URL=postgresql+psycopg://talentgo_app:replace-with-a-local-random-password@localhost:6543/talentgo
TEST_DATABASE_URL=postgresql+psycopg://talentgo_app:replace-with-a-local-random-password@localhost:6543/talentgo_test
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LLM_PROVIDER=mock
MOCK_CHUNK_DELAY=0.04

# Real model is opt-in. Keep keys only in backend/.env.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2400
CONTEXT_MAX_CHARACTERS=48000
